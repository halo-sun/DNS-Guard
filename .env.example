# DNS Guard Environment Configuration (Development defaults)
# Application
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Database (SQLite default for local development, PostgreSQL compatible)
DATABASE_URL=sqlite:///./dns_guard.db

# Security & Sessions
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (Frontend origins allowed to connect)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DNS Guard Operational Settings
OBSERVE_ONLY=true
DEFAULT_RETENTION_DAYS=30
MAX_UPLOAD_SIZE_MB=10
ENABLE_DEMO_MODE=true

# External Reputation (Disabled by default for privacy)
ENABLE_EXTERNAL_REPUTATION=false
